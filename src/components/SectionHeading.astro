---
interface Props { eyebrow: string; title: string; intro?: string; light?: boolean; }
const { eyebrow, title, intro, light = false } = Astro.props;
---
<div class:list={['section-heading', light && 'section-heading--light']}>
  <span class:list={['eyebrow', light && 'eyebrow--light']}>{eyebrow}</span>
  <h2 class="section-title">{title}</h2>
  {intro && <p class:list={['section-intro', light && 'dark-copy']}>{intro}</p>}
</div>
