---
import SectionHeading from '../SectionHeading.astro';
import CTASection from '../CTASection.astro';
import type { Translation } from '../../i18n/types';
import type { Locale } from '../../i18n/routes';
import { localizedPath } from '../../i18n/routes';
import { getVisualCopy } from '../../i18n/visual';

interface Props { copy: Translation; locale: Locale; }
const { copy, locale } = Astro.props;
const visual = getVisualCopy(locale);
---
<section class="page-hero"><div class="container"><span class="eyebrow eyebrow--light">{copy.aboutPage.eyebrow}</span><h1 class="display">{copy.aboutPage.title}</h1><p class="section-intro dark-copy">{copy.aboutPage.intro}</p></div></section>
<section class="editorial-photo-band"><div class="container editorial-photo-layout"><picture><source media="(max-width: 767px)" srcset="/assets/professional-hospitality-800.avif" type="image/avif" /><source media="(max-width: 767px)" srcset="/assets/professional-hospitality-800.webp" type="image/webp" /><source srcset="/assets/professional-hospitality.avif" type="image/avif" /><source srcset="/assets/professional-hospitality-800.webp 800w, /assets/professional-hospitality-1400.webp 1400w, /assets/professional-hospitality.webp 1600w" sizes="(max-width: 767px) 92vw, 55vw" type="image/webp" /><img src="/assets/professional-hospitality.jpg" srcset="/assets/professional-hospitality-800.webp 800w, /assets/professional-hospitality-1400.webp 1400w, /assets/professional-hospitality.webp 1600w" sizes="(max-width: 767px) 92vw, 55vw" alt={visual.aboutPhotoAlt} width="1600" height="2400" loading="lazy" /></picture><div><span class="eyebrow eyebrow--light">{copy.aboutPage.positionEyebrow}</span><p>{copy.aboutPage.positionIntro}</p></div></div></section>
<section class="section"><div class="container editorial"><div class="editorial-copy"><SectionHeading eyebrow={copy.aboutPage.missionEyebrow} title={copy.aboutPage.missionTitle} />{copy.aboutPage.missionParagraphs.map((paragraph) => <p>{paragraph}</p>)}</div><div class="editorial-list">{copy.aboutPage.rows.map((row) => <div class="editorial-row" data-reveal><strong>{row.label}</strong><div><h3>{row.title}</h3><p>{row.copy}</p></div></div>)}</div></div></section>
<section class="section section--paper"><div class="container about-position"><div class="about-mark" data-reveal><strong>{copy.aboutPage.mark}</strong><span>{copy.aboutPage.location}</span></div><div data-reveal><SectionHeading eyebrow={copy.aboutPage.positionEyebrow} title={copy.aboutPage.positionTitle} intro={copy.aboutPage.positionIntro} /><a class="btn btn--primary" style="margin-top: 28px" href={localizedPath(locale, 'contact')}>{copy.aboutPage.positionCta} <span aria-hidden="true">↗</span></a></div></div></section>
<CTASection copy={copy} locale={locale} />
