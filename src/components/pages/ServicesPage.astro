---
import SectionHeading from '../SectionHeading.astro';
import CTASection from '../CTASection.astro';
import type { Translation } from '../../i18n/types';
import type { Locale } from '../../i18n/routes';
import { getVisualCopy } from '../../i18n/visual';
import { getServiceCategories } from '../../data/serviceCategories';

interface Props { copy: Translation; locale: Locale; }
const { copy, locale } = Astro.props;
const visual = getVisualCopy(locale);
const services = getServiceCategories(locale);
---
<section class="page-hero"><div class="container"><span class="eyebrow eyebrow--light">{copy.servicesPage.eyebrow}</span><h1 class="display">{copy.servicesPage.title}</h1><p class="section-intro dark-copy">{copy.servicesPage.intro}</p></div></section>
<section class="photo-break photo-break--services"><div class="container photo-break-layout"><picture><source media="(max-width: 767px)" srcset="/assets/digital-business-services-900.avif" type="image/avif" /><source media="(max-width: 767px)" srcset="/assets/digital-business-services-900.webp" type="image/webp" /><source srcset="/assets/digital-business-services.avif" type="image/avif" /><source srcset="/assets/digital-business-services-900.webp 900w, /assets/digital-business-services.webp 1800w" sizes="(max-width: 767px) 92vw, 55vw" type="image/webp" /><img src="/assets/digital-business-services.jpg" srcset="/assets/digital-business-services-900.webp 900w, /assets/digital-business-services.webp 1800w" sizes="(max-width: 767px) 92vw, 55vw" alt={visual.servicesPhotoAlt} width="2400" height="1600" loading="lazy" /></picture><div><p>{visual.systemIntro}</p></div></div></section>
<section class="section"><div class="container"><div class="section-head"><SectionHeading eyebrow={copy.servicesPage.sectionEyebrow} title={copy.servicesPage.sectionTitle} intro={copy.servicesPage.sectionIntro} /></div><div class="service-detail-grid">{services.map((service) => <article class="service-detail" id={`service-${service.number}`} data-reveal><span class="service-detail-number">{service.number} / 08</span><div><h2>{service.title}</h2><ul>{service.items.map((item) => <li>{item}</li>)}</ul></div><p>{service.detail}</p></article>)}</div></div></section>
<CTASection copy={copy} locale={locale} />
