---
import type { PackageCopy } from '../i18n/types';
interface Props { packages: PackageCopy[]; from: string; currency: string; featuredLabel: string; }
const { packages, from, currency, featuredLabel } = Astro.props;
---
<div class="pricing-grid">
  {packages.map((item) => <article class:list={['price-card', item.featured && 'price-card--featured']} data-reveal>
    {item.featured && <span class="price-ribbon">{featuredLabel}</span>}
    <h3>{item.name}</h3>
    <div class="price"><small>{from}</small> {item.price} <small>{currency}</small></div>
    <p>{item.description}</p>
    <div class="fit">{item.fit}</div>
  </article>)}
</div>
