---
import SectionHeading from '../SectionHeading.astro';
import ContactForm from '../ContactForm.astro';
import type { Translation } from '../../i18n/types';
import type { Locale } from '../../i18n/routes';
import { company } from '../../data/site';
import { getVisualCopy } from '../../i18n/visual';

interface Props { copy: Translation; locale: Locale; }
const { copy, locale } = Astro.props;
const visual = getVisualCopy(locale);
---
<section class="page-hero page-hero--paper"><div class="container"><span class="eyebrow">{copy.contactPage.eyebrow}</span><h1 class="display">{copy.contactPage.title}</h1><p class="section-intro">{copy.contactPage.intro}</p></div></section>
<section class="section contact-section"><div class="container contact-grid"><div class="contact-intro"><div><SectionHeading eyebrow={copy.contactPage.sectionEyebrow} title={copy.contactPage.sectionTitle} intro={copy.contactPage.sectionIntro} /></div><div class="contact-photo"><picture><source srcset="/assets/sal-street-900.webp 900w, /assets/sal-street.webp 1800w" sizes="(max-width: 767px) 92vw, 42vw" type="image/webp" /><img src="/assets/sal-street.jpg" alt={visual.contactPhotoAlt} width="1800" height="790" loading="lazy" /></picture><span class="photo-label">{visual.photoContactLabel}</span></div><div class="contact-details"><div class="contact-detail"><small>{copy.contactPage.form.email}</small><a href={`mailto:${company.email}`}>{company.email}</a></div><div class="contact-detail"><small>{copy.common.location}</small><strong>{company.location}</strong></div><div class="contact-detail"><small>{copy.contactPage.analysisLabel}</small><strong>{copy.contactPage.freeLabel}</strong></div></div></div><ContactForm copy={copy} /></div></section>
