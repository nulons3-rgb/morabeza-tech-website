---
import type { ProjectCopy } from '../i18n/types';
interface Props { project: ProjectCopy; small?: boolean; }
const { project, small = false } = Astro.props;
---
<article class:list={['project-card', small && 'project-card--small']} data-category={project.category.toLowerCase()} data-reveal>
  <div class:list={['project-visual', `project-visual--${project.tone}`]}><div class="project-interface" aria-hidden="true"></div></div>
  <div class="project-content"><span class="pill">{project.label}</span><h3>{project.title}</h3><p>{project.description}</p><small>{project.services}</small></div>
  <span class="project-arrow" aria-hidden="true">↗</span>
</article>
