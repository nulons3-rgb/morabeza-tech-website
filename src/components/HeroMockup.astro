---
interface Props { label: string; analysisLabel: string; value: string; }
const { label, analysisLabel, value } = Astro.props;
---
<div class="mockup-stage" aria-label={label} data-reveal data-tilt>
  <div class="mockup-grid" aria-hidden="true"></div>
  <div class="mockup-orbit" aria-hidden="true"></div>
  <div class="browser">
    <div class="browser-bar"><i class="browser-dot"></i><i class="browser-dot"></i><i class="browser-dot"></i><span class="browser-url"></span></div>
    <div class="ui-screen">
      <div class="ui-top"><span class="ui-brand"></span><span class="ui-nav"><i></i><i></i><i></i></span></div>
      <div class="ui-hero"><div><span class="ui-kicker"></span><div class="ui-title"></div><div class="ui-copy"></div><div class="ui-button"></div></div><div class="ui-art"></div></div>
      <div class="ui-stat"><div><b></b><span></span></div><div><b></b><span></span></div><div><b></b><span></span></div></div>
    </div>
  </div>
  <div class="device-card" aria-hidden="true">
    <div class="device-speaker"></div>
    <div class="device-screen"><span></span><b></b><i></i><em></em></div>
  </div>
  <div class="floating-card"><small>{analysisLabel}</small><strong>{value}</strong><div class="floating-line"></div></div>
  <div class="mockup-location"><span></span>Praia · Cabo Verde</div>
</div>
<script>
  const tiltStage = document.querySelector<HTMLElement>('[data-tilt]');
  if (tiltStage && !window.matchMedia('(pointer: coarse)').matches) {
    tiltStage.addEventListener('pointermove', (event) => {
      const bounds = tiltStage.getBoundingClientRect();
      const x = ((event.clientX - bounds.left) / bounds.width - .5) * 7;
      const y = ((event.clientY - bounds.top) / bounds.height - .5) * -6;
      tiltStage.style.setProperty('--tilt-x', `${x}deg`);
      tiltStage.style.setProperty('--tilt-y', `${y}deg`);
    });
    tiltStage.addEventListener('pointerleave', () => {
      tiltStage.style.setProperty('--tilt-x', '0deg');
      tiltStage.style.setProperty('--tilt-y', '0deg');
    });
  }
</script>
