---
import SectionHeading from '../SectionHeading.astro';
import CTASection from '../CTASection.astro';
import FAQ from '../FAQ.astro';
import PricingCards from '../PricingCards.astro';
import type { Translation } from '../../i18n/types';
import type { Locale } from '../../i18n/routes';
interface Props { copy: Translation; locale: Locale; }
const { copy, locale } = Astro.props;
---
<section class="page-hero page-hero--paper"><div class="container"><span class="eyebrow">{copy.packagesPage.eyebrow}</span><h1 class="display">{copy.packagesPage.title}</h1><p class="section-intro">{copy.packagesPage.intro}</p></div></section>
<section class="section"><div class="container"><div class="section-head"><SectionHeading eyebrow={copy.packagesPage.sectionEyebrow} title={copy.packagesPage.sectionTitle} intro={copy.packagesPage.sectionIntro} /></div><PricingCards packages={copy.packagesPage.packages} featuredLabel={copy.common.mostChosen} consultationTitle={copy.packagesPage.consultationTitle} consultationIntro={copy.packagesPage.consultationIntro} consultationCta={copy.packagesPage.consultationCta} locale={locale} /><p class="section-intro" style="margin: 27px auto 0; text-align: center; font-size: .9rem">{copy.packagesPage.monthlySupport}</p></div></section>
<section class="section section--paper"><div class="container"><SectionHeading eyebrow={copy.packagesPage.faqEyebrow} title={copy.packagesPage.faqTitle} intro={copy.packagesPage.faqIntro} /><FAQ questions={copy.packagesPage.faq} /></div></section>
<CTASection copy={copy} locale={locale} />
